# Copy to the repository root as .env (git-ignored) and export before a live run:
#   set -a; . ./.env; set +a
# Only needed for live model calls. Replays and tests need no variables.

# Required for live runs.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown).
INCIDENT_MODEL=claude-opus-5-5
INCIDENT_EFFORT=medium
INCIDENT_FALLBACKS=1
INCIDENT_LOG_LEVEL=INFO
